<Page x:Class="Mustafina_shoes.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mustafina_shoes"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1100"
      Title="Каталог товаров"     FontFamily="Calibri" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <TextBox Name="TBSearch" TextChanged="TBSearch_TextChanged" Grid.Row="0" HorizontalAlignment="Left"  Margin="15,50,0,0" FontSize="17"  Width="250" Height="30" />
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox Name="ComboSort" SelectionChanged="ComboSort_SelectionChanged" Margin="0,50,0,0" Width="250" Height="30" FontSize="17">
                <TextBlock>Сортировка по умолчанию</TextBlock>
                <TextBlock>От А до Я</TextBlock>
                <TextBlock>По возрастанию цены</TextBlock>
                <TextBlock>По убыванию цены</TextBlock>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" >
            <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged"  Margin="0,50,15,0" Width="250"  Height="30" FontSize="17" >
                <TextBlock>Фильтр по умолчанию</TextBlock>
                <TextBlock>Женская обувь</TextBlock>
                <TextBlock>Мужская обвуь</TextBlock>
                <TextBlock>Детская обувь</TextBlock>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="0" Margin="15,0,0,0" >
            <TextBlock Name="FIOTB" FontSize="17" FontWeight="Bold"/>
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text=" Вы авторизованы как: " FontSize="17" />
                <TextBlock Name="RoleTB" FontSize="17" FontWeight="Bold" />
            </WrapPanel>
        </StackPanel>

        <ListView Name="ProductListView" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- Добавлен Background="{Binding RowBackground}" для подсветки -->
                    <Grid Background="{Binding RowBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions >
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="550"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <!-- Картинка -->
                        <Image Grid.RowSpan="4" Grid.Column="0" Source="{Binding ImagePath}" Stretch="UniformToFill" HorizontalAlignment="Center" />

                        <!-- Название -->
                        <TextBlock Text="{Binding NameProduct}" Grid.Row="0" Grid.Column="3" FontWeight="Bold"  Grid.ColumnSpan="5" FontSize="25" HorizontalAlignment="Left" />

                        <!-- Категория -->
                        <TextBlock Text="{Binding CategoryName}" Grid.Row="1" Grid.Column="1" FontSize="20"/>

                        <!-- Доступные размеры -->
                        <TextBlock Text="{Binding AvailableSizes, StringFormat=Размеры: {0}}" Grid.Row="2" Grid.Column="1" FontSize="20" />

                        <!-- Производитель -->
                        <TextBlock Text="{Binding ManufactureName}"   Grid.Row="0"  Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" FontSize="25"/>
                        <TextBlock Text=" | " Grid.Row="0"   Grid.Column="2"  FontSize="25"/>

                        <!-- Состав -->
                        <TextBlock Text="{Binding Compound}" TextWrapping="Wrap" Grid.Row="3" Grid.Column="1"  Grid.ColumnSpan="3" FontSize="20" />

                        <!-- Цена -->
                        <TextBlock Text="{Binding PriceProduct}" Grid.Row="2"  Grid.Column="4" FontSize="22" HorizontalAlignment="Center" FontWeight="Bold" />

                        <!-- Кнопка «Оформить заказ» -->
                        <Button Content="Оформить заказ" Grid.Row="2" Grid.Column="5" Width="160" Height="45" FontSize="14" VerticalAlignment="Center"  Margin="10,0,0,0" Background="#70B2AF" Foreground="White"
            BorderThickness="0" Cursor="Hand"
            Visibility="{Binding BuyVisibility}"
            Click="BtnBuy_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

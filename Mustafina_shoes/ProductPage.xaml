<Page x:Class="Mustafina_shoes.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mustafina_shoes"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1100"
      Title="ProductPage"     FontFamily="Calibri" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <TextBox Name="TBSearch" TextChanged="TBSearch_TextChanged" Grid.Row="0" HorizontalAlignment="Left" FontSize="17" Margin="15" Width="250" Height="30" />
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox Name="ComboSort" SelectionChanged="ComboSort_SelectionChanged" Width="250" Height="30" FontSize="17">
                <TextBlock>Сортировка по умолчанию</TextBlock>
                <TextBlock>От А до Я</TextBlock>
                <TextBlock>По возрастанию цены</TextBlock>
                <TextBlock>По убыванию цены</TextBlock>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" >
            <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" Width="250" Margin="15" Height="30" FontSize="17" >
                <TextBlock>Фильтр по умолчанию</TextBlock>
                <TextBlock>Женская обувь</TextBlock>
                <TextBlock>Мужская обвуь</TextBlock>
                <TextBlock>Детская обувь</TextBlock>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Вы вошли как: " FontSize="20" />
            <TextBlock Name="NameUser" FontSize="20" />
        </StackPanel>
            <ListView Name="ProductListView" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions >
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="330"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.RowSpan="4" Grid.Column="0"  Stretch="UniformToFill" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <Image Source="/res/lalala.png" />
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding NameProduct}" Grid.Row="0" Grid.Column="3"   FontSize="20" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Category.NameCategory}" Grid.Row="1" Grid.Column="1" FontSize="17"/>
                        <TextBlock Text="{Binding Subcategory.NameSubcategory}" Grid.Row="2" Grid.Column="1" FontSize="17"/>
                        <TextBlock Text="{Binding Manufacture.NameManufacture}"   Grid.Row="0"  Grid.Column="1" HorizontalAlignment="Right" FontSize="20"/>
                        <TextBlock Text=" | " Grid.Row="0"   Grid.Column="2"  FontSize="20"/>
                        <TextBlock Text="{Binding Compound}" Grid.Row="3" Grid.Column="1"  Grid.ColumnSpan="6" FontSize="17" />
                        <TextBlock Text="{Binding PriceProduct}" Grid.Row="2"  Grid.Column="4" FontSize="20" HorizontalAlignment="Center" FontWeight="Bold" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

<Window x:Class="Mustafina_shoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mustafina_shoes"
        mc:Ignorable="d"      
        Title="MainWindow" WindowState="Maximized" FontFamily="Calibri"   Background="#D2F6E7">  
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Чудо-Обувь" FontSize="30" HorizontalAlignment="Center"></TextBlock>
        
        <Image Source="/res/Чудо Обувь.ico"  Grid.Row="0" HorizontalAlignment="Left"/>
        <Frame Name="MainFrame" Grid.Row="1" ContentRendered="MainFrame_ContentRendered"  NavigationUIVisibility="Hidden"/>
        <Button Name="TBBack" Grid.Row="0" HorizontalAlignment="Right" Click="TBBack_Click" Background="#70B2AF" Visibility="Collapsed" FontSize="20"  Content="Назад" Width="150" Height="30"/>
    </Grid>
</Window>
